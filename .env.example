# The very first / main LINE OA (kept as top-level vars for backward
# compatibility — no changes needed on the LINE console side for this OA).
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here
LIFF_ID=your_liff_id_here
# Optional: give this OA a key/name (shown in the channel switcher). Defaults
# to key="default", name="โครงการหลัก" if not set.
# LINE_CHANNEL_KEY=peacehome
# LINE_CHANNEL_NAME=Peace Home Status

# Any additional project OAs (one per real-estate project). JSON array, one
# object per OA — see README "เพิ่ม LINE OA โครงการใหม่" for the full steps.
# LINE_CHANNELS_JSON=[{"key":"projectx","name":"Project X","access_token":"...","secret":"...","liff_id":"..."}]

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SECRET_KEY=change_this_to_a_long_random_string
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=changeme123
